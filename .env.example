# Required — absolute path to the drive folder to browse (Windows example).
# The server refuses to start if this is unset or unreadable.
PHOTOS_ROOT=E:\Photos

# Optional — port to listen on (default 8080).
# PORT=8080

# Optional — interface to bind. Keep 0.0.0.0 so phones on the LAN can reach it.
# HOST=0.0.0.0

# Optional — where to cache generated thumbnails. Default ./.thumb-cache
# Must NOT be inside PHOTOS_ROOT.
# THUMB_CACHE_DIR=.thumb-cache

# Optional — thumbnail width in pixels (default 400).
# THUMB_MAX_WIDTH=400

# Optional — where Like/Maybe/No culling tags are saved. Default ./.culls/culls.json
# Must NOT be inside PHOTOS_ROOT. scripts/apply-culls.ps1 reads this too.
# CULL_FILE=.culls/culls.json
